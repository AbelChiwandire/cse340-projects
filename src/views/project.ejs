<%- include("partials/header") %>

<main>
    <div class="layout-padding">
        <a class="back-btn" href="/projects">
            <svg xmlns="http://www.w3.org/2000/svg" fill="#000000" width="800px" height="800px" viewBox="0 0 52 52" data-name="Layer 1" id="Layer_1"><path d="M50,24H6.83L27.41,3.41a2,2,0,0,0,0-2.82,2,2,0,0,0-2.82,0l-24,24a1.79,1.79,0,0,0-.25.31A1.19,1.19,0,0,0,.25,25c0,.07-.07.13-.1.2l-.06.2a.84.84,0,0,0,0,.17,2,2,0,0,0,0,.78.84.84,0,0,0,0,.17l.06.2c0,.07.07.13.1.2a1.19,1.19,0,0,0,.09.15,1.79,1.79,0,0,0,.25.31l24,24a2,2,0,1,0,2.82-2.82L6.83,28H50a2,2,0,0,0,0-4Z"/></svg>
            Back to Projects
        </a>

        <div class="card card-details project-details-card">
            <div class="locale">
                <span class="font-size-sm"><%=
                        project.date.toLocaleDateString('en-US', {
                            month: 'short',
                            day: 'numeric',
                            year: 'numeric'
                        })
                    %>
                </span>
                <span><%= project.location %></span>
            </div>
            <div class="header">
                <h1 class="header-font-size"><%= project.title %></h1>
                <a class="generic-link" href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>
            </div>
            <div class="category-tags">
                <% categories.forEach(category => { %>
                    <a href="/categories/<%= category.category_id %>" class="category-tag"><%= category.name %></a>
                <% }); %>
                <% if (user && user.role_name === 'admin') { %>
                    <a class="edit-categories category-tag" href="/assign-categories/<%= project.project_id %>">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M20.8477 1.87868C19.6761 0.707109 17.7766 0.707105 16.605 1.87868L2.44744 16.0363C2.02864 16.4551 1.74317 16.9885 1.62702 17.5692L1.03995 20.5046C0.760062 21.904 1.9939 23.1379 3.39334 22.858L6.32868 22.2709C6.90945 22.1548 7.44285 21.8693 7.86165 21.4505L22.0192 7.29289C23.1908 6.12132 23.1908 4.22183 22.0192 3.05025L20.8477 1.87868ZM18.0192 3.29289C18.4098 2.90237 19.0429 2.90237 19.4335 3.29289L20.605 4.46447C20.9956 4.85499 20.9956 5.48815 20.605 5.87868L17.9334 8.55027L15.3477 5.96448L18.0192 3.29289ZM13.9334 7.3787L3.86165 17.4505C3.72205 17.5901 3.6269 17.7679 3.58818 17.9615L3.00111 20.8968L5.93645 20.3097C6.13004 20.271 6.30784 20.1759 6.44744 20.0363L16.5192 9.96448L13.9334 7.3787Z" fill="currentColor"/>
                        </svg>
                        Edit Categories
                    </a>
                <% } %>
            </div>
            <p class="project-details-description"><%= project.description %></p>
        </div>

        <% if (user) { %>
            <div class="volunteer-actions">
                <% if (isVolunteer) { %>
                    <div class="volunteer-state">You are volunteering for this project</div>
                    <form action="/projects/<%= project.project_id %>/volunteer/remove" method="POST">
                        <button type="submit" class="remove-volunteer-link">Remove yourself as a volunteer</button>
                    </form>
                <% } else { %>
                    <form action="/projects/<%= project.project_id %>/volunteer" method="POST">
                        <button type="submit" class="volunteer-link">Volunteer for this project</button>
                    </form>
                <% } %>
            </div>
        <% } %>
        
        <% if (user && user.role_name === 'admin') { %>
            <a class="new-organization-link" href="/edit-project/<%= project.project_id %>">Edit Service Project</a>
        <% } %>
    </div>
</main>

<%- include("partials/footer") %>