<%- include("partials/header") %>

<main>
    <div class="layout-padding">
        <a class="back-btn" href="/projects">
            <svg xmlns="http://www.w3.org/2000/svg" fill="#000000" width="800px" height="800px" viewBox="0 0 52 52" data-name="Layer 1" id="Layer_1"><path d="M50,24H6.83L27.41,3.41a2,2,0,0,0,0-2.82,2,2,0,0,0-2.82,0l-24,24a1.79,1.79,0,0,0-.25.31A1.19,1.19,0,0,0,.25,25c0,.07-.07.13-.1.2l-.06.2a.84.84,0,0,0,0,.17,2,2,0,0,0,0,.78.84.84,0,0,0,0,.17l.06.2c0,.07.07.13.1.2a1.19,1.19,0,0,0,.09.15,1.79,1.79,0,0,0,.25.31l24,24a2,2,0,1,0,2.82-2.82L6.83,28H50a2,2,0,0,0,0-4Z"/></svg>
            Back to Projects
        </a>

        <div class="card card-details project-details-card">
            <div class="locale">
                <span class="font-size-sm"><%=
                        project.date.toLocaleDateString('en-US', {
                            month: 'short',
                            day: 'numeric',
                            year: 'numeric'
                        })
                    %>
                </span>
                <span><%= project.location %></span>
            </div>
            <div class="header">
                <h1 class="header-font-size"><%= project.title %></h1>
                <a class="generic-link" href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>
            </div>
            <div class="category-tags">
                <% categories.forEach(category => { %>
                    <a href="/categories/<%= category.category_id %>" class="category-tag"><%= category.name %></a>
                <% }); %>
            </div>
            <p class="project-details-description"><%= project.description %></p>
        </div>
    </div>
</main>

<%- include("partials/footer") %>