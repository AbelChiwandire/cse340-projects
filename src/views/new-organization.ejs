<%- include('partials/header') %>

<main>
  <div class="layout-padding">
    <h1 class="header-margin-top header-font-size"><%= title %></h1>

  <form class="organization-form" action="/new-organization" method="POST">
      <div class="form-group">
        <label for="name">Organization Name:</label>
        <input
          type="text"
          id="name"
          name="name"
          maxlength="150"
          required
        />
      </div>

      <div class="form-group">
        <label for="description">Description:</label>
        <textarea
          id="description"
          name="description"
          rows="4"
          maxlength="500"
          required
        ></textarea>
      </div>

      <div class="form-group">
        <label for="contactEmail">Contact Email:</label>
        <input
          type="email"
          id="contactEmail"
          name="contactEmail"
          required
        />
      </div>

      <button class="new-organization-link organization-submit" type="submit">Create Organization</button>
    </form>
  </div>

</main>

<%- include('partials/footer') %>