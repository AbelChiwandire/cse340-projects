<%- include("partials/header") %>

<main>
    <div class="layout-padding">
        <a class="back-btn" href="/organizations">
            <svg xmlns="http://www.w3.org/2000/svg" fill="#000000" width="800px" height="800px" viewBox="0 0 52 52" data-name="Layer 1" id="Layer_1"><path d="M50,24H6.83L27.41,3.41a2,2,0,0,0,0-2.82,2,2,0,0,0-2.82,0l-24,24a1.79,1.79,0,0,0-.25.31A1.19,1.19,0,0,0,.25,25c0,.07-.07.13-.1.2l-.06.2a.84.84,0,0,0,0,.17,2,2,0,0,0,0,.78.84.84,0,0,0,0,.17l.06.2c0,.07.07.13.1.2a1.19,1.19,0,0,0,.09.15,1.79,1.79,0,0,0,.25.31l24,24a2,2,0,1,0,2.82-2.82L6.83,28H50a2,2,0,0,0,0-4Z"/></svg>
            Back to Organizations
        </a>
        <div class="org-profile">
            <div class="org-logo">
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> Logo">
            </div>

            <div class="org-details">
                <h1 class="header-font-size"><%= organization.name %></h1>
                <p><%= organization.description %></p>
                <div class="org-footer">
                    <a class="generic-link" href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
                </div>
            </div>
        </div>

        <div class="border"></div>

        <div>
            <h2>Service Projects</h2>
            <% if (projects.length === 0) { %>
                <p class="no-projects">No upcoming projects at the moment. Please check back later!</p>
            <% } else { %>
                <div class="organization-details-cards">
                    <% projects.forEach(project => { %>
                        <a class="bar-card" href="/projects/<%= project.project_id %>">
                            <span class="font-size-sm"><%=
                                project.date.toLocaleDateString('en-US', {
                                    month: 'short',
                                    day: 'numeric',
                                    year: 'numeric'
                                }); 
                            %></span>
                            <h3><%= project.title %></h3>
                        </a>
                    <% }); %>
                </div>
            <% } %>
        </div>
        <a class="new-organization-link" href="/edit-organization/<%= organization.organization_id %>">Edit Organization</a>
    </div>
</main>

<%- include("partials/footer") %>