<%- include('partials/header.ejs') %>

<main>
    <div class="layout-padding">
        <h1 class="header-margin-top header-font-size"><%= title %></h1>

        <form class="organization-form" action="/new-category" method="POST">
            <div class="form-group">
                <label for="name">Category Name:</label>
                <input type="text" id="name" name="name" maxlength="100" required>
            </div>
            <button class="new-organization-link organization-submit" type="submit">Create Category</button>
        </form>
    </div>
</main>

<%- include('partials/footer.ejs') %>