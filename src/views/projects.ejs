<%- include("partials/header") %>

<main>
    <div class="layout-padding">
        <h1 class="header-margin-top header-font-size"><%= title %></h1>

        <p class="description-font-size gray-text">Upcoming Service Projects</p>
        <div class="project-cards">
            <% projects.forEach(project => { %>
                <div class="project-card">
                    <div>
                        <a class="projects-project-link generic-link" href="/projects/<%= project.project_id %>">
                            <span><%=
                                project.date.toLocaleDateString('en-US', {
                                    month: 'short',
                                    day: 'numeric',
                                    year: 'numeric'
                                }) 
                            %></span>
                            <span><%= project.title %></span>
                        </a>
                    </div>
                    <div>
                        <a class="generic-link" href="/organizations/<%= project.organization_id %>">(<%= project.organization_name %>)</a>
                    </div>
                </div>
            <% }); %>
        </div>
        <p><a class="new-organization-link" href="/new-project">Add a New Service Project</a></p>
    </div>

</main>

<%- include("partials/footer") %>