<%- include("partials/header") %>

<main>
    <div class="layout-padding">
        <h1 class="header-margin-top header-font-size"><%= title %></h1>
        
        <p class="description-font-size gray-text">Explore the different areas where you can volunteer and make a meaningful impact in your community.</p>

        <div class="categories-container">
            <% categories.forEach(category => { %>
                <a href="/categories/<%= category.category_id %>" class="category-card card card-details">
                    <h2><%= category.name %></h2>
                </a>
            <% }); %>
        </div>
        <% if (user && user.role_name === 'admin') { %>
            <a class="new-organization-link" href="/new-category">Add a new Category</a>
        <% } %>
    </div>
</main>

<%- include("partials/footer") %>